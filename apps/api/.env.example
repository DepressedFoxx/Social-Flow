NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://socialflow:socialflow_local@localhost:55432/socialflow?schema=public

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# Local storage adapter used by MEDIA-01. Replace with an S3 adapter when deploying.
MEDIA_STORAGE_PATH=.data/media
MEDIA_UPLOAD_TTL_SECONDS=600

# Meta: configure after creating your Meta App. See docs/META_SETUP.md
META_APP_ID=
META_APP_SECRET=
META_ENABLE_INSTAGRAM=false
META_LOGIN_CONFIG_ID=
META_GRAPH_VERSION=v25.0
META_CALLBACK_URL=
META_PUBLIC_API_ORIGIN=
META_TOKEN_ENCRYPTION_KEY=
