{
  "name": "@social-flow/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run db:generate",
    "dev": "nest start --watch",
    "prebuild": "npm run db:generate",
    "build": "nest build",
    "start": "node dist/main.js",
