generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  googleId     String?    @unique
  passwordHash String?
  name         String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  workspace    Workspace?
  sessions     Session[]
}

model Workspace {
  id        String    @id @default(cuid())
  ownerId   String    @unique
  owner     User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  timezone  String    @default("Asia/Ho_Chi_Minh")
  planCode  String    @default("PERSONAL")
  mediaQuotaBytes BigInt @default(262144000)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  channels  Channel[]
  posts     Post[]
  media     MediaAsset[]
  metaOAuth MetaOAuth[]
}

enum Platform {
  FACEBOOK
  INSTAGRAM
}

model Channel {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  platform    Platform
  name        String
  isMock      Boolean   @default(false)
  externalId  String?
  credential  ChannelCredential?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  posts       Post[]

  @@index([workspaceId, platform])
  @@unique([workspaceId, platform, externalId])
}

enum PostStatus {
  DRAFT
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
}

model Post {
  id              String     @id @default(cuid())
  workspaceId     String
  workspace       Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channelId       String
  channel         Channel    @relation(fields: [channelId], references: [id], onDelete: Restrict)
  clientRequestId String?
  title           String
  content         String     @default("")
  status          PostStatus @default(DRAFT)
  scheduledAt     DateTime?
  publishedAt     DateTime?
  version         Int        @default(1)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  media           PostMedia[]
  attempts        PublishAttempt[]

  @@unique([workspaceId, clientRequestId])
  @@index([workspaceId, status])
  @@index([workspaceId, scheduledAt])
  @@index([channelId])
}

enum MediaStatus {
  PENDING
  UPLOADED
  READY
}

model MediaAsset {
  id              String      @id @default(cuid())
  workspaceId     String
  workspace       Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  filename        String
  mimeType        String
  size            Int
  storageKey      String      @unique
  status          MediaStatus @default(PENDING)
  uploadTokenHash String?
  uploadExpiresAt DateTime?
  confirmedAt     DateTime?
  createdAt       DateTime    @default(now())
  postMedia       PostMedia?

  @@index([workspaceId, status])
  @@index([createdAt])
}

model PostMedia {
  postId       String
  post         Post       @relation(fields: [postId], references: [id], onDelete: Cascade)
  mediaAssetId String     @unique
  mediaAsset   MediaAsset @relation(fields: [mediaAssetId], references: [id], onDelete: Cascade)
  position     Int

  @@id([postId, mediaAssetId])
  @@unique([postId, position])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  csrfToken String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@index([userId])
}

model OAuthAttempt {
  stateHash String   @id
  verifier  String
  expiresAt DateTime

  @@index([expiresAt])
}

model PublishAttempt {
  id String @id @default(cuid())
  postId String
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  scheduleVersion Int
  status String
  startedAt DateTime @default(now())
  finishedAt DateTime?
  leaseExpiresAt DateTime
  dispatchStartedAt DateTime?
  errorCode String?
  errorMessage String?
  externalPostId String?
  @@unique([postId, scheduleVersion])
  @@index([status, leaseExpiresAt])
}

model ChannelCredential {
  channelId String @id
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  encryptedToken String
  pageId String
  expiresAt DateTime?
  connectedAt DateTime @default(now())
}

model MetaOAuth {
  stateHash String @id
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sessionHash String
  consumedAt DateTime?
  payload String?
  expiresAt DateTime
  @@index([expiresAt])
  @@index([sessionHash])
}
